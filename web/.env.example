VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_RELAY_WS_URL=ws://localhost:8000
# Authenticated application endpoint returning {url, token, robotIdentity}.
# Never put a LiveKit API secret or robot device key in a VITE_ variable.
VITE_LIVEKIT_SESSION_ENDPOINT=
# LiveKit is the visitor default. Use relay explicitly for the local simulator.
VITE_ROBOT_TRANSPORT=livekit
# Local development only: existing hand_tracking.py service and its assigned room.
# The target stays server-side. This does not align live SLAM to the saved map.
ACTION_POINTS_TARGET=
ACTION_POINTS_ROOM_ID=
